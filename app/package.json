{
  "name": "aurum-cleaner",
  "productName": "Aurum Cleaner",
  "private": true,
  "version": "1.1.0",
  "description": "A premium, free storage-cleaning desktop app for Windows and macOS.",
  "author": "Aurum Cleaner",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev:all": "concurrently -k -n VITE,ELECTRON -c blue,yellow \"npm:dev\" \"wait-on tcp:5173 && npm:dev:electron\"",
    "build": "vite build",
    "build:electron": "npm run build && electron-builder",
    "release": "npm run build && electron-builder --publish always",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:mac": "npm run build && electron-builder --mac",
    "release:mac": "npm run build && electron-builder --mac --publish always",
    "test": "node --test test/mac.test.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.10.0",
    "trash": "^10.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.aurumcleaner.app",
    "productName": "Aurum Cleaner",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "Gomby711",
      "repo": "aurum-cleaner"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "afterSign": "build/adhocSign.cjs",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "minimumSystemVersion": "11.0",
      "extendInfo": {
        "NSDesktopFolderUsageDescription": "Aurum Cleaner looks in your Desktop folder for large and duplicate files you may want to remove.",
        "NSDocumentsFolderUsageDescription": "Aurum Cleaner looks in your Documents folder for large and duplicate files you may want to remove.",
        "NSDownloadsFolderUsageDescription": "Aurum Cleaner looks in your Downloads folder for large and duplicate files you may want to remove.",
        "NSRemovableVolumesUsageDescription": "Aurum Cleaner can analyze external drives you choose to scan.",
        "NSAppleEventsUsageDescription": "Aurum Cleaner asks Finder to move leftover macOS installers to the Trash."
      }
    },
    "dmg": {
      "title": "Aurum Cleaner ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "directories": {
      "output": "release"
    }
  }
}
